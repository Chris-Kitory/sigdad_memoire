<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mon espace — SIGDA Makala</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="tableau-bord">
    <div class="conteneur">
      <div class="tableau-bord-entete">
        <div>
          <h1>Mon espace citoyen</h1>
          <p>Soumettez une nouvelle demande et suivez son avancement.</p>
        </div>
      </div>

      <div class="grille-principale grille-avec-formulaire">
        <div class="panneau">
          <h2>Nouvelle demande</h2>

          <div id="erreur-form" class="message-erreur"></div>

          <div id="bon-paiement" class="bon-paiement">
            <div class="bon-paiement-entete">
              <span class="bon-paiement-code" id="bon-code"></span>
              <span class="bon-paiement-prix" id="bon-prix"></span>
            </div>
            <div class="bon-paiement-corps" id="bon-instructions"></div>
            <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;">
              <a id="bon-lien-impression" href="#" target="_blank" class="bouton bouton-secondaire bouton-petit">Imprimer le bon</a>
              <a id="bon-lien-apercu" href="#" target="_blank" class="bouton bouton-secondaire bouton-petit">Voir l'aperçu du document</a>
            </div>
          </div>

          <form id="form-demande" onsubmit="soumettreDemande(event)">
            <div class="champ-bloc">
              <label class="champ-label" for="type-document">Type de document</label>
              <select id="type-document" class="champ-select" required onchange="surChangementType()">
                <option value="">Sélectionner…</option>
              </select>
            </div>

            <div class="champ-bloc" id="bloc-prix" style="display:none;">
              <label class="champ-label">Prix</label>
              <div id="affichage-prix" style="font-weight:600;color:var(--or);"></div>
            </div>

            <div class="champ-bloc" id="bloc-date-naissance" style="display:none;">
              <label class="champ-label" for="date-evenement">Date de naissance (de l'enfant)</label>
              <input type="date" id="date-evenement" class="champ" style="width:100%" onchange="surChangementType()">
            </div>

            <div class="champ-bloc" id="bloc-jugement" style="display:none;">
              <label class="champ-label" for="jugement">Numéro du jugement supplétif</label>
              <input type="text" id="jugement" class="champ" style="width:100%" placeholder="Délai de 90 jours dépassé — jugement requis">
            </div>

            <div id="bloc-identite" class="formulaire-identite" style="margin-bottom:18px;"></div>

            <div class="champ-bloc">
              <label class="champ-label" for="piece">Pièce identitaire (carte d'identité, passeport… — PDF, JPG, PNG)</label>
              <input type="file" id="piece" class="champ-fichier" accept=".pdf,.jpg,.jpeg,.png" required onchange="apercuFichier()">
              <div id="apercu-fichier" style="display:none;margin-top:10px;" class="piece-apercu">
                <img id="apercu-image" style="display:none;" alt="Aperçu de la pièce">
                <p id="apercu-nom-pdf" style="display:none;" class="piece-apercu-lien"></p>
              </div>
            </div>

            <button type="submit" class="bouton bouton-primaire bouton-large">Soumettre la demande</button>
          </form>
        </div>

        <div class="panneau">
          <h2>Mes demandes</h2>
          <div id="liste-demandes" class="liste-demandes">
            <div class="etat-vide">Chargement…</div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/demandes-communes.js"></script>
  <script>
    let CATALOGUE = {};

    async function chargerCatalogue() {
      const res = await fetch('/demandes/catalogue');
      const data = await res.json();
      const select = document.getElementById('type-document');
      data.documents.forEach((doc) => {
        CATALOGUE[doc.id] = doc;
        const option = document.createElement('option');
        option.value = doc.id;
        option.textContent = doc.estNaissance
          ? doc.label + ' (gratuit ≤ 90 jours)'
          : doc.label + ' — ' + doc.prix + ' $';
        select.appendChild(option);
      });

      const typePreselectionne = new URLSearchParams(window.location.search).get('type');
      if (typePreselectionne && CATALOGUE[typePreselectionne]) {
        select.value = typePreselectionne;
        surChangementType();
        select.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function rendreChampsIdentite(doc) {
      const zone = document.getElementById('bloc-identite');
      if (!doc) { zone.innerHTML = ''; return; }
      zone.innerHTML = doc.champsIdentite.map((champ) => `
        <div class="champ-bloc">
          <label class="champ-label">${champ.label}</label>
          <input type="${champ.type}" class="champ" style="width:100%" data-champ-identite="${champ.id}" required>
        </div>
      `).join('');
    }

    function surChangementType() {
      const id = document.getElementById('type-document').value;
      const doc = CATALOGUE[id];
      const blocDateNaissance = document.getElementById('bloc-date-naissance');
      const blocJugement = document.getElementById('bloc-jugement');
      const blocPrix = document.getElementById('bloc-prix');
      const affichagePrix = document.getElementById('affichage-prix');

      if (!doc) {
        blocDateNaissance.style.display = 'none';
        blocJugement.style.display = 'none';
        blocPrix.style.display = 'none';
        rendreChampsIdentite(null);
        return;
      }

      rendreChampsIdentite(doc);

      if (doc.estNaissance) {
        blocDateNaissance.style.display = 'block';
        const dateVal = document.getElementById('date-evenement').value;
        if (dateVal) {
          const jours = Math.floor((Date.now() - new Date(dateVal).getTime()) / 86400000);
          const gratuit = jours <= doc.delaiGratuitJours;
          blocJugement.style.display = gratuit ? 'none' : 'block';
          blocPrix.style.display = 'block';
          affichagePrix.textContent = gratuit ? 'Gratuit (dans le délai de ' + doc.delaiGratuitJours + ' jours)' : 'Payant — jugement supplétif requis';
        } else {
          blocJugement.style.display = 'none';
          blocPrix.style.display = 'none';
        }
      } else {
        blocDateNaissance.style.display = 'none';
        blocJugement.style.display = 'none';
        blocPrix.style.display = 'block';
        affichagePrix.textContent = doc.prix + ' $ (payable en Francs Congolais au taux du jour)';
      }
    }

    function apercuFichier() {
      const fichier = document.getElementById('piece').files[0];
      const zone = document.getElementById('apercu-fichier');
      const img = document.getElementById('apercu-image');
      const nomPdf = document.getElementById('apercu-nom-pdf');
      if (!fichier) { zone.style.display = 'none'; return; }

      zone.style.display = 'block';
      if (fichier.type.startsWith('image/')) {
        img.src = URL.createObjectURL(fichier);
        img.style.display = 'block';
        nomPdf.style.display = 'none';
      } else {
        img.style.display = 'none';
        nomPdf.style.display = 'block';
        nomPdf.textContent = 'Fichier PDF sélectionné : ' + fichier.name;
      }
    }

    async function chargerMesDemandes() {
      const zone = document.getElementById('liste-demandes');
      try {
        const res = await fetch('/demandes/mes-demandes', { credentials: 'include' });
        const data = await res.json();

        if (!data.demandes || data.demandes.length === 0) {
          zone.innerHTML = '<div class="etat-vide">Vous n\'avez encore soumis aucune demande.</div>';
          return;
        }

        zone.innerHTML = data.demandes.map((d) => {
          let actions = `<div class="ligne-demande-actions">`;
          if (d.statut === 'en_attente_paiement') {
            actions += `<a href="/citoyen/bon/${d.id}" target="_blank" class="bouton bouton-secondaire bouton-petit">Bon</a>`;
          }
          actions += `<a href="/document/apercu/${d.id}" target="_blank" class="bouton bouton-secondaire bouton-petit">Aperçu</a>`;
          if (d.statut === 'signe') {
            actions += `<a href="/demandes/${d.id}/pdf" class="bouton bouton-primaire bouton-petit">PDF</a>`;
          }
          actions += `</div>`;
          return rendreLigneDemande(d, actions);
        }).join('');
      } catch (err) {
        zone.innerHTML = '<div class="etat-vide">Impossible de charger vos demandes.</div>';
      }
    }

    async function soumettreDemande(e) {
      e.preventDefault();
      const typeDocument = document.getElementById('type-document').value;
      const dateEvenement = document.getElementById('date-evenement').value;
      const jugement = document.getElementById('jugement').value;
      const fichier = document.getElementById('piece').files[0];
      const erreur = document.getElementById('erreur-form');
      const bonPaiement = document.getElementById('bon-paiement');
      erreur.style.display = 'none';
      bonPaiement.style.display = 'none';

      const formData = new FormData();
      formData.append('typeDocument', typeDocument);
      if (dateEvenement) formData.append('dateEvenement', dateEvenement);
      if (jugement) formData.append('jugementSuppletifNumero', jugement);
      formData.append('pieceIdentitaire', fichier);
      document.querySelectorAll('[data-champ-identite]').forEach((input) => {
        formData.append(input.dataset.champIdentite, input.value);
      });

      try {
        const res = await fetch('/demandes', { method: 'POST', credentials: 'include', body: formData });
        const data = await res.json();

        if (!res.ok) {
          erreur.textContent = data.error || 'Soumission impossible.';
          erreur.style.display = 'block';
          return;
        }

        document.getElementById('bon-code').textContent = data.demande.bon_paiement;
        document.getElementById('bon-prix').textContent = data.demande.gratuit ? 'GRATUIT' : parseFloat(data.demande.prix_usd) + ' $';
        document.getElementById('bon-instructions').textContent = data.instructions;
        document.getElementById('bon-lien-impression').href = '/citoyen/bon/' + data.demande.id;
        document.getElementById('bon-lien-apercu').href = '/document/apercu/' + data.demande.id;
        bonPaiement.style.display = 'block';

        document.getElementById('form-demande').reset();
        document.getElementById('bloc-date-naissance').style.display = 'none';
        document.getElementById('bloc-jugement').style.display = 'none';
        document.getElementById('bloc-prix').style.display = 'none';
        document.getElementById('apercu-fichier').style.display = 'none';
        rendreChampsIdentite(null);
        chargerMesDemandes();
      } catch (err) {
        erreur.textContent = 'Erreur de connexion au serveur.';
        erreur.style.display = 'block';
      }
    }

    chargerCatalogue();
    chargerMesDemandes();
  </script>
</body>
</html>
