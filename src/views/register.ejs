<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Créer un compte — SIGDA Makala</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="page-auth">
    <div class="carte-auth">
      <h1>Créer un compte citoyen</h1>
      <p class="carte-auth-sous">Pour soumettre et suivre vos demandes de documents.</p>

      <div id="erreur" class="message-erreur"></div>

      <form id="form-inscription" onsubmit="inscription(event)">
        <div class="champ-bloc">
          <label class="champ-label" for="nom">Nom</label>
          <input type="text" id="nom" class="champ" style="width:100%" required>
        </div>
        <div class="champ-bloc">
          <label class="champ-label" for="postnom">Postnom</label>
          <input type="text" id="postnom" class="champ" style="width:100%">
        </div>
        <div class="champ-bloc">
          <label class="champ-label" for="email">Adresse e-mail</label>
          <input type="email" id="email" class="champ" style="width:100%" required>
        </div>
        <div class="champ-bloc">
          <label class="champ-label" for="mot-de-passe">Mot de passe</label>
          <input type="password" id="mot-de-passe" class="champ" style="width:100%" minlength="6" required>
        </div>
        <button type="submit" class="bouton bouton-primaire bouton-large">Créer mon compte</button>
      </form>

      <div class="carte-auth-pied">
        Déjà un compte ? <a href="/login">Se connecter</a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    async function inscription(e) {
      e.preventDefault();
      const nom = document.getElementById('nom').value;
      const postnom = document.getElementById('postnom').value;
      const email = document.getElementById('email').value;
      const motDePasse = document.getElementById('mot-de-passe').value;
      const erreur = document.getElementById('erreur');
      erreur.style.display = 'none';

      try {
        const resInscription = await fetch('/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nom, postnom, email, motDePasse }),
        });
        const dataInscription = await resInscription.json();

        if (!resInscription.ok) {
          erreur.textContent = dataInscription.error || 'Inscription impossible.';
          erreur.style.display = 'block';
          return;
        }

        // Connexion automatique apres inscription
        const resConnexion = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email, motDePasse }),
        });

        if (resConnexion.ok) {
          window.location.href = '/citoyen';
        } else {
          window.location.href = '/login';
        }
      } catch (err) {
        erreur.textContent = 'Erreur de connexion au serveur.';
        erreur.style.display = 'block';
      }
    }
  </script>
</body>
</html>
