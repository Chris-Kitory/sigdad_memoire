<header class="entete">
  <div class="conteneur entete-barre">
    <a href="/" class="marque">
      <img class="marque-sceau" src="/Kinshasa.webp" alt="Kinshasa">
      <span class="marque-texte">
        <span class="marque-titre">SIGDA</span>
        <span class="marque-sous">Commune de Makala</span>
      </span>
    </a>

    <div style="display:flex;align-items:center;gap:18px;">
      <% if (!utilisateur) { %>
        <div class="entete-nav">
          <a href="/login" class="bouton bouton-secondaire bouton-petit">Se connecter</a>
          <a href="/register" class="bouton bouton-primaire bouton-petit">Créer un compte</a>
        </div>
      <% } else { %>
        <div class="entete-utilisateur">
          <% if (utilisateur.role === 'citoyen') { %>
            <a href="/citoyen" style="text-decoration:none;color:var(--autorite);font-weight:600;">Mon profil</a>
          <% } else if (utilisateur.role === 'agent') { %>
            <a href="/agent" style="text-decoration:none;color:var(--autorite);font-weight:600;">Tableau de bord</a>
          <% } else if (utilisateur.role === 'bourgmestre') { %>
            <a href="/bourgmestre" style="text-decoration:none;color:var(--autorite);font-weight:600;">Tableau de bord</a>
          <% } %>
          <span><%= utilisateur.email %></span>
          <button type="button" class="bouton-texte" onclick="deconnexion()">Se déconnecter</button>
        </div>
      <% } %>
    </div>
  </div>

  <nav class="sous-nav">
    <div class="conteneur sous-nav-liste">
      <a href="/" class="<%= page === 'accueil' ? 'actif' : '' %>">Accueil</a>
      <a href="/renseignements" class="<%= page === 'renseignements' ? 'actif' : '' %>">Renseignements</a>
      <a href="/structure" class="<%= page === 'structure' ? 'actif' : '' %>">Structure</a>
      <a href="/documents" class="<%= page === 'documents' ? 'actif' : '' %>">Documents</a>
      <a href="/police" class="<%= page === 'police' ? 'actif' : '' %>">La Police</a>
      <a href="/demande-document" class="<%= page === 'demande-document' ? 'actif' : '' %>">Demande de document</a>
      <a href="/a-propos" class="<%= page === 'a-propos' ? 'actif' : '' %>">À propos</a>
    </div>
  </nav>
</header>

<script>
  async function deconnexion() {
    await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
    window.location.href = '/';
  }
</script>
