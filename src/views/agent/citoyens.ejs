<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Citoyens inscrits — SIGDA Makala</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="tableau-bord">
    <div class="conteneur">
      <div class="tableau-bord-entete">
        <div>
          <h1>Citoyens inscrits</h1>
          <p>Citoyens ayant soumis au moins une demande auprès de la commune.</p>
        </div>
        <a href="/agent" class="bouton bouton-secondaire bouton-petit">← Retour</a>
      </div>

      <div class="panneau">
        <div id="liste"><div class="etat-vide">Chargement…</div></div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    async function charger() {
      const zone = document.getElementById('liste');
      const res = await fetch('/demandes/citoyens', { credentials: 'include' });
      const data = await res.json();

      if (!data.citoyens || data.citoyens.length === 0) {
        zone.innerHTML = '<div class="etat-vide">Aucun citoyen n\'a encore soumis de demande.</div>';
        return;
      }

      const lignes = data.citoyens.map((c) => `
        <tr>
          <td>${c.id}</td>
          <td>${c.nom} ${c.postnom || ''}</td>
          <td>${c.email}</td>
          <td>${c.nombre_demandes}</td>
          <td>${c.demandes_signees}</td>
          <td>${new Date(c.date_creation).toLocaleDateString('fr-FR')}</td>
        </tr>`).join('');

      zone.innerHTML = `
        <div style="overflow-x:auto;">
          <table class="table-donnees">
            <thead><tr><th>N°</th><th>Nom</th><th>Email</th><th>Demandes</th><th>Signées</th><th>Inscrit le</th></tr></thead>
            <tbody>${lignes}</tbody>
          </table>
        </div>`;
    }

    charger();
  </script>
</body>
</html>
