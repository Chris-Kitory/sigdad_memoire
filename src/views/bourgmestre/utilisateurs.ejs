<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Utilisateurs — SIGDA Makala</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="tableau-bord">
    <div class="conteneur">
      <div class="tableau-bord-entete">
        <div>
          <h1>Personnes inscrites</h1>
          <p>Ensemble des comptes du système — citoyens et personnel communal.</p>
        </div>
        <a href="/bourgmestre" class="bouton bouton-secondaire bouton-petit">← Retour</a>
      </div>

      <div class="panneau">
        <div id="liste"><div class="etat-vide">Chargement…</div></div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    const LIBELLES_ROLE = { citoyen: 'Citoyen', agent: 'Agent', bourgmestre: 'Bourgmestre' };
    const CLASSE_ROLE = { citoyen: 'attente', agent: 'verifie', bourgmestre: 'signe' };

    async function charger() {
      const zone = document.getElementById('liste');
      const res = await fetch('/demandes/utilisateurs', { credentials: 'include' });
      const data = await res.json();

      if (!data.utilisateurs || data.utilisateurs.length === 0) {
        zone.innerHTML = '<div class="etat-vide">Aucun utilisateur.</div>';
        return;
      }

      const lignes = data.utilisateurs.map((u) => `
        <tr>
          <td>${u.id}</td>
          <td>${u.nom} ${u.postnom || ''}</td>
          <td>${u.email}</td>
          <td><span class="pastille pastille-${CLASSE_ROLE[u.role]}">${LIBELLES_ROLE[u.role]}</span></td>
          <td>${u.role === 'citoyen' ? u.nombre_demandes + ' demande(s)' : '—'}</td>
          <td>${new Date(u.date_creation).toLocaleDateString('fr-FR')}</td>
        </tr>`).join('');

      zone.innerHTML = `
        <div style="overflow-x:auto;">
          <table class="table-donnees">
            <thead><tr><th>N°</th><th>Nom</th><th>Email</th><th>Rôle</th><th>Demandes</th><th>Inscrit le</th></tr></thead>
            <tbody>${lignes}</tbody>
          </table>
        </div>`;
    }

    charger();
  </script>
</body>
</html>
