<%
  const numeroDossier = 'N° ' + String(demande.id).padStart(5, '0') + '/' + new Date(demande.date_creation).getFullYear();
%>
<div class="doc-officiel">
  <div class="doc-officiel-entete">
    <svg width="46" height="46" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
      <circle cx="20" cy="20" r="18.5" fill="none" stroke="#1B3358" stroke-width="1.5"/>
      <circle cx="20" cy="20" r="14" fill="none" stroke="#B8863A" stroke-width="1"/>
      <path d="M20 10 L23 17 L30.5 17.7 L25 22.6 L26.8 30 L20 26 L13.2 30 L15 22.6 L9.5 17.7 L17 17 Z" fill="#1B3358"/>
    </svg>
    <div class="doc-officiel-entete-texte">
      <div class="doc-officiel-pays">Ville de Kinshasa</div>
      <div class="doc-officiel-commune">Commune de Makala</div>
      <div class="doc-officiel-service">Service de la Population</div>
    </div>
    <div class="doc-officiel-numero"><%= numeroDossier %></div>
  </div>

  <h2 class="doc-officiel-titre"><%= doc ? doc.label.toUpperCase() : demande.type_document %></h2>

  <p class="doc-officiel-paragraphe"><%= paragraphe %></p>

  <% if (blocSupplementaire) { %>
    <div class="doc-officiel-bloc">
      <% blocSupplementaire.forEach((ligne) => { %>
        <p><%= ligne %></p>
      <% }) %>
    </div>
  <% } %>

  <div class="doc-officiel-signature">
    <div>Fait à Makala, le <%= demande.date_signature ? new Date(demande.date_signature).toLocaleDateString('fr-FR') : '……………' %></div>
    <div class="doc-officiel-signature-bloc">
      <div class="doc-officiel-signature-titre">Le Bourgmestre</div>
      <% if (demande.statut === 'signe') { %>
        <svg width="110" height="40" viewBox="0 0 110 40" class="doc-officiel-paraphe">
          <path d="M5,28 C15,8 20,32 28,18 C34,8 38,30 46,20 C52,12 56,26 64,16 C70,8 76,24 84,14 C90,8 96,20 104,12"
            fill="none" stroke="#2F6E51" stroke-width="1.6"/>
        </svg>
        <svg width="100" height="100" viewBox="0 0 100 100" class="doc-officiel-tampon">
          <circle cx="50" cy="50" r="46" fill="none" stroke="#2255A4" stroke-width="1.6"/>
          <circle cx="50" cy="50" r="38" fill="none" stroke="#2255A4" stroke-width="1"/>
          <text x="50" y="30" text-anchor="middle" font-size="6.2" fill="#2255A4" font-family="Helvetica" font-weight="bold">RÉPUBLIQUE DÉM. CONGO</text>
          <text x="50" y="52" text-anchor="middle" font-size="6.6" fill="#2255A4" font-family="Helvetica" font-weight="bold">COMMUNE DE MAKALA</text>
          <text x="50" y="62" text-anchor="middle" font-size="5.6" fill="#2255A4" font-family="Helvetica">Bureau du Bourgmestre</text>
          <text x="50" y="78" text-anchor="middle" font-size="6.2" fill="#2255A4" font-family="Helvetica" font-weight="bold">VILLE DE KINSHASA</text>
        </svg>
      <% } %>
    </div>
  </div>

  <div class="doc-officiel-pied">
    <span class="doc-officiel-serie"><%= demande.code_suivi %></span>
    <span class="pastille pastille-<%= { en_attente_paiement: 'attente', verifie: 'verifie', signe: 'signe', rejete: 'rejete', expire: 'rejete' }[demande.statut] %>">
      <%= { en_attente_paiement: 'En attente de paiement', verifie: 'Vérifiée', signe: 'Signée', rejete: 'Rejetée', expire: 'Expirée' }[demande.statut] %>
    </span>
  </div>

  <% if (demande.statut === 'signe') { %>
    <div class="doc-officiel-sceau">
      Sceau numérique : <%= demande.code_qr %>
    </div>
  <% } %>
</div>
