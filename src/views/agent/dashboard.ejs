<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Espace agent — SIGDA Makala</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="tableau-bord">
    <div class="conteneur">
      <div class="tableau-bord-entete">
        <div>
          <h1>Guichet — Paiement &amp; vérification</h1>
          <p>Le citoyen présente son bon de paiement à l'accueil ; recherchez-le ou retrouvez-le dans la liste.</p>
        </div>
        <a href="/agent/citoyens" class="bouton bouton-secondaire bouton-petit">Citoyens inscrits</a>
      </div>

      <div class="grille-principale">
        <div class="panneau">
          <h2>Rechercher par bon de paiement</h2>
          <form class="champ-groupe" onsubmit="rechercherBon(event)">
            <input type="text" id="recherche-bon" class="champ" placeholder="Ex : BON-482913" required>
            <button type="submit" class="bouton bouton-primaire">Rechercher</button>
          </form>
          <div id="resultat-recherche" style="margin-top:14px;"></div>
        </div>

        <div class="panneau">
          <h2>Demandes en attente de paiement</h2>
          <div id="liste-demandes" class="liste-demandes">
            <div class="etat-vide">Chargement…</div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/demandes-communes.js"></script>
  <script>
    function actionsPourDemande(d) {
      if (d.statut !== 'en_attente_paiement') return '';
      return `<a href="/agent/verifier/${d.id}" class="bouton bouton-primaire bouton-petit">Traiter</a>`;
    }

    async function chargerDemandes() {
      const zone = document.getElementById('liste-demandes');
      try {
        const res = await fetch('/demandes/a-verifier', { credentials: 'include' });
        const data = await res.json();
        zone.innerHTML = rendreTableauDemandes(data.demandes, 'Action', actionsPourDemande);
      } catch (err) {
        zone.innerHTML = '<div class="etat-vide">Impossible de charger les demandes.</div>';
      }
    }

    async function rechercherBon(e) {
      e.preventDefault();
      const code = document.getElementById('recherche-bon').value.trim();
      const zone = document.getElementById('resultat-recherche');
      zone.innerHTML = 'Recherche…';

      try {
        const res = await fetch('/demandes/bon/' + encodeURIComponent(code), { credentials: 'include' });
        const data = await res.json();

        if (!res.ok) {
          zone.innerHTML = '<div class="etat-vide">' + (data.error || 'Introuvable.') + '</div>';
          return;
        }

        zone.innerHTML = rendreTableauDemandes([data.demande], 'Action', actionsPourDemande);
      } catch (err) {
        zone.innerHTML = '<div class="etat-vide">Erreur de recherche.</div>';
      }
    }

    chargerDemandes();
  </script>
</body>
</html>
